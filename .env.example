# ==========================================
# 1. SEGURIDAD Y AUTENTICACIÓN (Opción 1)
# ==========================================
# Contraseña maestra o PIN para entrar a la aplicación (en desarrollo por defecto es: admin123)
APP_PASSWORD=tu_clave_secreta_aqui

# Clave secreta para cifrar las cookies de sesión (mínimo 32 caracteres)
# Puedes generar una aleatoria ejecutando en terminal: openssl rand -base64 32
NUXT_SESSION_PASSWORD=clave_aleatoria_super_secreta_minimo_32_caracteres_123456

# ==========================================
# 2. BASE DE DATOS EN LA NUBE (Turso / LibSQL)
# ==========================================
# Si dejas estas variables vacías en desarrollo local, se usará SQLite local en .data/finanzas.db
# Para producción en Vercel: crea una base de datos gratuita en https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
